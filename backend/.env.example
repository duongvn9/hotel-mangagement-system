# Copy thành .env khi chạy backend trực tiếp bằng `npm run start:dev` (không qua Docker).
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

MONGODB_URI=mongodb://hms:hms_dev_password@localhost:27017/hms?authSource=admin

# Firebase Admin SDK (service account). Lấy ở Firebase Console > Project settings > Service accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# VNPay sandbox: https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return

# Gmail (dùng App Password, không dùng mật khẩu tài khoản)
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM="HMS <no-reply@example.com>"
