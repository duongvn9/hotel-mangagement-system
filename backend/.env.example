# Copy thành .env khi chạy backend trực tiếp bằng `npm run start:dev` (không qua Docker).
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

MONGODB_URI=mongodb://hms:hms_dev_password@localhost:27017/hms?authSource=admin

# Firebase. Chỉ cần FIREBASE_PROJECT_ID để kiểm tra ID token khi đăng nhập.
# CLIENT_EMAIL và PRIVATE_KEY (service account, Firebase Console > Project settings > Service accounts)
# chỉ cần khi backend tạo tài khoản Firebase (UC43).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# VNPay sandbox: https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_IPN_URL=

# Gmail (dùng App Password, không dùng mật khẩu tài khoản)
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM="HMS <no-reply@example.com>"
