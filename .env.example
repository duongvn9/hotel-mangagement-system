# Copy thành .env (KHÔNG commit file .env).
# Dev: mọi biến đều có giá trị mặc định, không cần .env.
# Production: bắt buộc điền MONGO_ROOT_USERNAME, MONGO_ROOT_PASSWORD, CORS_ORIGINS.

# ---------- MongoDB ----------
MONGO_ROOT_USERNAME=hms
# Chỉ dùng chữ và số (ký tự đặc biệt phải URL-encode vì nằm trong MONGODB_URI)
MONGO_ROOT_PASSWORD=change_me_to_a_long_random_string
MONGO_DB=hms

# ---------- Cổng ----------
WEB_PORT=80            # production (nginx)
FRONTEND_PORT=5173     # dev
BACKEND_PORT=3000      # dev
MONGO_PORT=27017       # dev

# ---------- Backend ----------
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=false

# Firebase: PROJECT_ID đủ để kiểm tra ID token; CLIENT_EMAIL, PRIVATE_KEY cho tạo tài khoản (UC43)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost/payment/vnpay-return
VNPAY_IPN_URL=

# Gmail (App Password)
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM="HMS <no-reply@example.com>"

# ---------- S3 / MinIO storage (ảnh loại phòng) ----------
# Backend ghi ảnh lên S3 tương thích; frontend đọc ảnh qua VITE_ASSET_BASE_URL (công khai).
# Dùng server ngoài: điền S3_ENDPOINT, S3_BUCKET và khóa; KHÔNG commit khóa thật.
# Dùng S3 local (docker compose --profile storage up, dịch vụ RustFS), đặt:
#   S3_ENDPOINT=http://rustfs:9000   S3_BUCKET=hms   S3_ACCESS_KEY_ID=<RUSTFS_ACCESS_KEY>
#   S3_SECRET_ACCESS_KEY=<RUSTFS_SECRET_KEY>   VITE_ASSET_BASE_URL=http://localhost:9000/hms
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
VITE_ASSET_BASE_URL=
# RustFS local (chỉ khi bật profile storage); khóa tối thiểu 8 ký tự
RUSTFS_ACCESS_KEY=hms_rustfs
RUSTFS_SECRET_KEY=change_me_min_8_chars
RUSTFS_BUCKET=hms
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# ---------- Frontend (nhúng vào bundle lúc build, chỉ để giá trị public) ----------
VITE_APP_NAME="Grand Emily Hotel"
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Tag image khi build production
IMAGE_TAG=latest

# H9 Gmail notification — disabled by default; never commit real credentials.
NOTIFICATIONS_ENABLED=false
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFICATIONS_FROM_NAME="Grand Emily Hotel"
NOTIFICATIONS_MAX_ATTEMPTS=3
NOTIFICATIONS_RETRY_BASE_DELAY_MS=1000
NOTIFICATIONS_SEND_TIMEOUT_MS=10000
NOTIFICATIONS_QUEUE_CAPACITY=100
NOTIFICATIONS_SHUTDOWN_TIMEOUT_MS=15000
