# Copy thành .env.local khi chạy `npm run dev` trực tiếp (không qua Docker).
# Mọi biến VITE_* sẽ bị nhúng vào JS gửi xuống trình duyệt: KHÔNG đặt secret ở đây.

# Backend mà dev server proxy /api tới
VITE_PROXY_TARGET=http://localhost:3000
# Base URL frontend gọi API (để /api/v1 khi dùng proxy hoặc nginx)
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Grand Emily HMS

# Firebase Web config (public, lấy ở Firebase Console > Project settings > Your apps)
# Để trống thì màn đăng nhập chuyển sang chế độ dev: chọn tài khoản seed (backend gửi header x-dev-*)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
